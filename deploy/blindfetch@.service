[Unit]
Description=Blindfetch %i
After=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/blindfetch
EnvironmentFile=/home/ubuntu/blindfetch/deploy/%i.env
# systemd does not expand variables in the program path, so go through sh.
ExecStart=/bin/sh -c 'exec /home/ubuntu/blindfetch/target/release/$BIN $ARGS'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
